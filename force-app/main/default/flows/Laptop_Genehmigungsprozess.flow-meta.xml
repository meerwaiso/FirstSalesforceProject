<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <status>Active</status>
    <label>Laptop Genehmigungsprozess</label>
    <description>AutoLaunched Flow: Bei Neuanlage von Laptop__c prueft den Preis und genehmigt automatisch oder startet Approval Process</description>
    <interviewLabel>Laptop Genehmigungsprozess</interviewLabel>
    <isTemplate>false</isTemplate>
    <processType>AutoLaunchedFlow</processType>
    <variables>
        <name>varRecordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetRecord</targetReference>
        </connector>
    </start>
    <getRecords>
        <name>GetRecord</name>
        <label>Laptop Record laden</label>
        <locationX>200</locationX>
        <locationY>140</locationY>
        <connector>
            <targetReference>Decision_Preis_Pruefung</targetReference>
        </connector>
        <filterItems>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varRecordId</elementReference>
            </value>
        </filterItems>
        <object>Laptop__c</object>
        <storedRecords>varLaptop</storedRecords>
    </getRecords>
    <decision>
        <name>Decision_Preis_Pruefung</name>
        <label>Preis Pruefung</label>
        <locationX>350</locationX>
        <locationY>280</locationY>
        <defaultConnector>
            <targetReference>Update_Status_Ausstehend</targetReference>
        </defaultConnector>
        <connector>
            <targetReference>Update_Status_Genehmigt</targetReference>
        </connector>
        <rules>
            <name>Preis_bis_1500</name>
            <condition>
                <leftValue>
                    <elementReference>varLaptop[0].Preis__c</elementReference>
                </leftValue>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1500.0</numberValue>
                </rightValue>
            </condition>
            <conditionType>And</conditionType>
        </rules>
    </decision>
    <updateRecords>
        <name>Update_Status_Genehmigt</name>
        <label>Status auf Genehmigt setzen</label>
        <locationX>200</locationX>
        <locationY>420</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Genehmigt</stringValue>
            </value>
        </inputAssignments>
        <object>Laptop__c</object>
        <recordId>
            <elementReference>varLaptop[0].Id</elementReference>
        </recordId>
    </updateRecords>
    <updateRecords>
        <name>Update_Status_Ausstehend</name>
        <label>Status auf Ausstehend setzen</label>
        <locationX>500</locationX>
        <locationY>420</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Ausstehend</stringValue>
            </value>
        </inputAssignments>
        <object>Laptop__c</object>
        <recordId>
            <elementReference>varLaptop[0].Id</elementReference>
        </recordId>
    </updateRecords>
</Flow>