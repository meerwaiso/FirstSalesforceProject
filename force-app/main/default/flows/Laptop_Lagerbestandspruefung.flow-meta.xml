<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <status>Active</status>
    <label>Laptop Lagerbestandspruefung</label>
    <description>AutoLaunched Flow: Nach Genehmigung (Status = Genehmigt) automatisch Lagerbestand pruefen und Status aktualisieren</description>
    <interviewLabel>Laptop Lagerbestandspruefung</interviewLabel>
    <isTemplate>false</isTemplate>
    <processType>AutoLaunchedFlow</processType>
    <variables>
        <name>varRecordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetRecord</targetReference>
        </connector>
    </start>
    <getRecords>
        <name>GetRecord</name>
        <label>Laptop Record laden</label>
        <locationX>200</locationX>
        <locationY>140</locationY>
        <connector>
            <targetReference>Get_Lager_Laptops</targetReference>
        </connector>
        <filterItems>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varRecordId</elementReference>
            </value>
        </filterItems>
        <object>Laptop__c</object>
        <storedRecords>varLaptop</storedRecords>
    </getRecords>
    <getRecords>
        <name>Get_Lager_Laptops</name>
        <label>Lagerbestand pruefen</label>
        <locationX>350</locationX>
        <locationY>280</locationY>
        <connector>
            <targetReference>Decision_Lagerbestand</targetReference>
        </connector>
        <filterItems>
            <field>Modell__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varLaptop[0].Modell__c</elementReference>
            </value>
        </filterItems>
        <filterItems>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Auf_Lager</stringValue>
            </value>
        </filterItems>
        <object>Laptop__c</object>
        <storedRecords>Get_Lager_Laptops_Result</storedRecords>
    </getRecords>
    <decision>
        <name>Decision_Lagerbestand</name>
        <label>Lagerbestand Entscheidung</label>
        <locationX>500</locationX>
        <locationY>420</locationY>
        <defaultConnector>
            <targetReference>Update_Nachbestellung</targetReference>
        </defaultConnector>
        <connector>
            <targetReference>Update_Zugewiesen_Antrag</targetReference>
        </connector>
        <rules>
            <name>Lagerbestand_verfuegbar</name>
            <condition>
                <leftValue>
                    <elementReference>Get_Lager_Laptops_Result</elementReference>
                </leftValue>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </condition>
        </rules>
    </decision>
    <updateRecords>
        <name>Update_Zugewiesen_Antrag</name>
        <label>Antrag auf Zugewiesen setzen</label>
        <locationX>350</locationX>
        <locationY>560</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Zugewiesen</stringValue>
            </value>
        </inputAssignments>
        <object>Laptop__c</object>
        <recordId>
            <elementReference>varLaptop[0].Id</elementReference>
        </recordId>
        <connector>
            <targetReference>Update_Lager_Laptop_Zugewiesen</targetReference>
        </connector>
    </updateRecords>
    <updateRecords>
        <name>Update_Lager_Laptop_Zugewiesen</name>
        <label>Lager-Laptop auf Zugewiesen setzen</label>
        <locationX>350</locationX>
        <locationY>700</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Zugewiesen</stringValue>
            </value>
        </inputAssignments>
        <object>Laptop__c</object>
        <recordId>
            <elementReference>Get_Lager_Laptops_Result[0].Id</elementReference>
        </recordId>
    </updateRecords>
    <updateRecords>
        <name>Update_Nachbestellung</name>
        <label>Antrag auf Nachbestellung setzen</label>
        <locationX>650</locationX>
        <locationY>560</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Nachbestellung</stringValue>
            </value>
        </inputAssignments>
        <object>Laptop__c</object>
        <recordId>
            <elementReference>varLaptop[0].Id</elementReference>
        </recordId>
    </updateRecords>
</Flow>