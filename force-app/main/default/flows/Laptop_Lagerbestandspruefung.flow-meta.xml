<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <status>Active</status>
    <label>Laptop Lagerbestandspruefung</label>
    <description>Record-Activated Flow: Nach Genehmigung (Status = Genehmigt) automatisch Lagerbestand pruefen und Status aktualisieren</description>
    <interviewLabel>Laptop Lagerbestandspruefung</interviewLabel>
    <isTemplate>false</isTemplate>
    <processType>RecordTriggered</processType>
    <recordTrigger>
        <object>Laptop__c</object>
        <triggerType>Update</triggerType>
        <triggerOrder>2</triggerOrder>
        <isRecordUpdatedToBeAccessed>true</isRecordUpdatedToBeAccessed>
        <isRecordUpdatedToBeUpdated>true</isRecordUpdatedToBeUpdated>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Genehmigt</stringValue>
            </value>
        </filters>
    </recordTrigger>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Lager_Laptops</targetReference>
        </connector>
    </start>
    <getRecords>
        <name>Get_Lager_Laptops</name>
        <label>Lagerbestand pruefen</label>
        <locationX>200</locationX>
        <locationY>140</locationY>
        <connector>
            <targetReference>Decision_Lagerbestand</targetReference>
        </connector>
        <filterItems>
            <field>Modell__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Record.Modell__c</elementReference>
            </value>
        </filterItems>
        <filterItems>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Auf_Lager</stringValue>
            </value>
        </filterItems>
        <object>Laptop__c</object>
        <storedRecords>Get_Lager_Laptops_Result</storedRecords>
    </getRecords>
    <decision>
        <name>Decision_Lagerbestand</name>
        <label>Lagerbestand Entscheidung</label>
        <locationX>350</locationX>
        <locationY>280</locationY>
        <defaultConnector>
            <targetReference>Update_Nachbestellung</targetReference>
        </defaultConnector>
        <connector>
            <targetReference>Update_Zugewiesen_Antrag</targetReference>
        </connector>
        <rules>
            <name>Lagerbestand_verfuegbar</name>
            <condition>
                <leftValue>
                    <elementReference>Get_Lager_Laptops_Result</elementReference>
                </leftValue>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </condition>
        </rules>
    </decision>
    <assignment>
        <name>Update_Zugewiesen_Antrag</name>
        <label>Antrag auf Zugewiesen setzen</label>
        <locationX>200</locationX>
        <locationY>420</locationY>
        <assignmentItems>
            <assignToReference>Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Zugewiesen</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Lager_Laptop_Zugewiesen</targetReference>
        </connector>
    </assignment>
    <updateRecords>
        <name>Update_Lager_Laptop_Zugewiesen</name>
        <label>Lager-Laptop auf Zugewiesen setzen</label>
        <locationX>200</locationX>
        <locationY>560</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Zugewiesen</stringValue>
            </value>
        </inputAssignments>
        <object>Laptop__c</object>
        <recordId>{!Get_Lager_Laptops_Result[0].Id}</recordId>
    </updateRecords>
    <assignment>
        <name>Update_Nachbestellung</name>
        <label>Antrag auf Nachbestellung setzen</label>
        <locationX>500</locationX>
        <locationY>420</locationY>
        <assignmentItems>
            <assignToReference>Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Nachbestellung</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Email_Einkauf</targetReference>
        </connector>
    </assignment>
    <emailAlert>
        <name>Send_Email_Einkauf</name>
        <label>Email an Einkauf senden</label>
        <locationX>650</locationX>
        <locationY>560</locationY>
        <emailTemplate>Laptop_Nachbestellung_Template</emailTemplate>
        <senderDlpPolicy>OrganizationWideEmailAddress</senderDlpPolicy>
        <senderType>CurrentUser</senderType>
        <targets>
            <targetAddress>einkauf@firma.de</targetAddress>
            <targetType>EmailAddress</targetType>
        </targets>
    </emailAlert>
</Flow>