<?xml version="1.0" encoding="UTF-8"?>
<!-- SCRUM-457: Write-side PS — record, change and cancel an absence.
     CRUD/FLS row of the PO ticket, per data item: Create, Edit and Delete
     (= cancel) belong to the account manager themselves AND to team leads
     (a team lead records it for a colleague who is off sick and cannot do it
     themselves, AC1). The five Apex-written mirror fields are editable=true
     here: AbsenceSyncHandler writes them in USER mode, and FLS editable is what
     allows that update — measured, with editable=false the whole create rolls
     back ("fields being inaccessible on Sobject Account"). The three formula
     fields stay editable=false. No Permission Profile is touched (house rule). -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SCRUM457_AbsenceWrite</fullName>
    <label>SCRUM-457 Absence Write</label>
    <description>SCRUM-457: Create/Edit/Delete on Absence__c plus FLS edit on its data items. For account managers and team leads (AC1: a team lead records the absence of a colleague who cannot do it). Cancel = delete.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Absence__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Absence__c.Absent_User__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Absence__c.Deputy__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Absence__c.Start__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Absence__c.End__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Absence_Start__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Absence_End__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Absence_Deputy__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Absence_Deputy_Start__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Absence_Deputy_End__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.Absence_In_Window__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.Absence_Ohne_Deputy__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.Absence_Anzeige__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
