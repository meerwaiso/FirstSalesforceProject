<?xml version="1.0" encoding="UTF-8"?>
<!-- SCRUM-457: Deputy access PS (ADR-3). The deputy must work a customer and
     its open Opportunities and Cases WITHOUT owning them (AC4), and the grant
     must be revocable when the absence ends or is cancelled (AC5).

     Measured in this org (design F1, two routes): Account.AccountAccess — the
     Sales Cloud per-record share field — does not exist, and sharing rules
     (sharingRule metadata) exist only for custom objects. So per-record cross-
     owner sharing of a standard Sales Cloud object is not expressible here.
     The remaining mechanism is object-level access with viewAllRecords=true,
     which is per USER, not per record.

     CONSEQUENCE (must be stated to the PO, not hidden): while the absence is
     active the deputy can see every Account/Opportunity/Case of the org, not
     only the absent manager's. Salesforce cannot scope it to one customer
     without changing the owner, which AC7 forbids.

     Scope is deliberately minimal for the story: Account read-only (the deputy
     must not edit the customer), Opportunity read+edit (AC4 "update the
     opportunities, just as the account manager would"), Case read-only (AC4:
     "Cases only need to be visible, not editable"). No Create, no Delete.

     Revocation (AC5) is an Org-Setup action, NOT Apex: PermissionSetAssignment
     is a system object, and a system-object DML inside this trigger's
     transaction would be a MIXED_DML_OPERATION when a non-admin edits the
     Absence__c record. The team lead assigns and removes this PS in Setup for
     the duration of the absence. -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SCRUM457_DeputyAccess</fullName>
    <label>SCRUM-457 Deputy Access</label>
    <description>SCRUM-457: Deputy record access - read Account, read+edit Opportunity, read Case, viewAllRecords so non-owned records are reachable. Per user, not per record: assign only during an absence and remove it when the absence ends (AC5).</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Opportunity</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Case</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
</PermissionSet>
