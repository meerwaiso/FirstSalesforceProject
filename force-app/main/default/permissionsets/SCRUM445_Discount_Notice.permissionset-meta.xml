<?xml version="1.0" encoding="UTF-8"?>
<!-- SCRUM-445 / SCRUM-447: the Queueable DiscountApprovalNotification inserts a FeedItem
     in USER mode (the enqueuing user's context), so the insert needs an explicit FLS grant.
     Measured 2026-10-13: 44 Queueable jobs Completed with NumberOfErrors=0 produced 0 FeedItems,
     while the 5 FeedItems of that day came from direct Apex runs (system mode, FLS bypassed).
     No Permission Set in the repo granted FeedItem before this. House shape: SCRUM442_TestObjectAccess. -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SCRUM445_Discount_Notice</fullName>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>FeedItem</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>SCRUM445 Discount Approval Notice</label>
    <description>SCRUM-445/447: FeedItem create+read so the discount-approval Queueable can inform the direct manager in user mode.</description>
</PermissionSet>
