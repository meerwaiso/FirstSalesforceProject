<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Offene_Churn_Aufgaben_nach_Owner</fullName>
    <description>Offene Churn-Aufgaben gruppiert nach Account Owner</description>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Task.Owner.Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Offene Churn Aufgaben nach Owner</name>
    <reportType>TaskList</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <filter>
        <field>Task.IsClosed</field>
        <operation>equals</operation>
        <value>0</value>
    </filter>
    <filter>
        <field>Task.Subject</field>
        <operation>contains</operation>
        <value>Churn</value>
    </filter>
</Report>