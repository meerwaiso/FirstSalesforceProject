<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <name>Betreuungslast_nach_Firma</name>
    <description>Betreuungslast je Firma (SCRUM-396): alle Kontakte (scope organization, AC3), gruppiert nach Account; ohne Account in null-Gruppe (AC4). Je Gruppe: Record Count + Sum offene Faelle (AC5); Detail: Name, Firma, Stufe, offene Faelle, Inhaber (AC6).</description>
    <reportType>SCRUM396_Betreuungslast</reportType>
    <scope>organization</scope>
    <format>Summary</format>
    <columns>
        <field>Contact.Name</field>
    </columns>
    <columns>
        <field>Contact.Betreuungsstufe__c</field>
    </columns>
    <columns>
        <field>Contact.Open_Cases_Count__c</field>
        <aggregateTypes>Sum</aggregateTypes>
    </columns>
    <columns>
        <field>Contact.Owner</field>
    </columns>
    <groupingsDown>
        <field>Contact.Account.Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
</Report>
