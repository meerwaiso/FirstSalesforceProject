<?xml version="1.0" encoding="UTF-8"?>
<!-- SCRUM-468 AC8: the overdue overview the team leads open every Friday.
     reportType is the ReportType of the previous phase: the raw custom object is
     not a report type (measured: "Demo_Devic__c is not a report type").
     Column/filter token form "BaseObject$Field__c" is the house proof
     reports/Sales/Offene_Werte_Verlauf.report-meta.xml (reportType
     SCRUM417_OpportunityHistory__c, columns OpenOpportunityHistory__c$Open_Count__c).
     groupingsDown = the overdue-day count, Desc = longest overdue first (AC8 sort).
     The grouping field is deliberately NOT repeated in <columns> - the deploy
     rejects a grouping that is also a selected column (house caution in
     Kunde_ohne_Kontaktperson); the count still shows as the group heading.
     No timeFrameFilter: nothing here is date-windowed, and a fiscal frame would
     silently drop rows (skill: salesforce-deploy-diagnostics). -->
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <field>Demo_Devic__c$Name</field>
    </columns>
    <columns>
        <field>Demo_Devic__c$Designation_Name__c</field>
    </columns>
    <columns>
        <field>Demo_Devic__c$Serial_Number__c</field>
    </columns>
    <columns>
        <field>Demo_Devic__c$Current_Customer__c</field>
    </columns>
    <columns>
        <field>Demo_Devic__c$Current_Loan_Colleague__c</field>
    </columns>
    <columns>
        <field>Demo_Devic__c$Current_Loan_Due_Date__c</field>
    </columns>
    <description>SCRUM-468 AC8: devices that are lent out and past their due date - device, customer, the colleague who lent it, due date, grouped by days overdue, longest overdue first.</description>
    <filter>
        <criteriaItems>
            <column>Demo_Devic__c$Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>Lent_Out</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <field>Demo_Devic__c$Current_Loan_Overdue_Days__c</field>
        <sortOrder>Desc</sortOrder>
    </groupingsDown>
    <name>SCRUM468_Overdue_Devices</name>
    <reportType>SCRUM468_Overdue_Devices__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
</Report>
