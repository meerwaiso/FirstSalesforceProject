<?xml version="1.0" encoding="UTF-8"?>
<!-- SCRUM-442 AC6: ÜBERVIEW der dissatisfied Kunden (AccountList, org-weit).
     Grouping ACCOUNT.NAME (house: Betreuungslast_nach_Firma, deployed green —
     the ONLY cross-object token form verified in deployed reports; the CASES.*
     form is NOT found in any deployed report -> avoided, SCRUM-432 finding).
     Columns: the 5 system-maintained Account.Satisfaction_* fields (this
     ticket's own custom fields, resolve plainly). Filter: Satisfaction_Arger__c
     equals 'Ärger' — the three-state indicator (AC5) is the filter, so the
     overview lists EXACTLY the dissatisfied customers (AC6), never 'OK', never
     'Kein Daten'. SCRUM-443 fix: NO timeFrameFilter — the Rebuilder writes
     Fenster_Start = today-3mon (92 days back), which a LAST90 window can never
     match, so the filter rendered 0 rows org-wide forever; no 3-month interval
     token exists (CLI metadataRegistry: LAST7/30/60/90/120, LASTMONTH, LASTWEEK,
     CURRENT, CUSTOM). The window is stated in the column and the description.
     Report-level sharing/folder placement = Org step (@devops-agent, design
     §11). -->
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <field>Account.Satisfaction_Durchdurch__c</field>
    </columns>
    <columns>
        <field>Account.Satisfaction_Min__c</field>
    </columns>
    <columns>
        <field>Account.Satisfaction_Anzahl__c</field>
    </columns>
    <columns>
        <field>Account.Satisfaction_Fenster_Start__c</field>
    </columns>
    <columns>
        <field>Account.Satisfaction_Arger__c</field>
    </columns>
    <description>SCRUM-442 AC6: exactly the dissatisfied customers (Satisfaction_Arger__c=AErger). Period = Rebuilder window today-3mon, stated in the column Satisfaction_Fenster_Start__c. Worst first. Grouping ACCOUNT.NAME.</description>
    <filter>
        <criteriaItems>
            <column>Account.Satisfaction_Arger__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>&#196;rger</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>ACCOUNT.NAME</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Miserable_Kunde_Satisfaction</name>
    <reportType>AccountList</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <sortColumn>Account.Satisfaction_Durchdurch__c</sortColumn>
    <sortOrder>Asc</sortOrder>
    <!-- SCRUM-443 (Tester-found defect, AC6): the timeFrameFilter was
         INTERVAL_LAST90 on Account.Satisfaction_Fenster_Start__c, but the
         Rebuilder writes Fenster_Start = today.addMonths(-3) = 92 days back,
         i.e. ALWAYS outside a LAST90 window -> the report rendered 0 rows
         org-wide, forever, in both orgs (measured by the Tester: Total Records
         0 while 1 Account carried Satisfaction_Arger__c='AErger'). There is no
         3-month interval token (CLI metadataRegistry lists LAST7/30/60/90/120,
         LASTMONTH, LASTWEEK, CURRENT, CUSTOM - no LAST3MONTHS), so option (b)
         LAST120 would silently mislabel the period and option (c) fudges the
         data. Fix = drop the timeFrameFilter: the Rebuilder window is already
         the source of truth and is shown as the column
         Satisfaction_Fenster_Start__c; the indicator filter
         Satisfaction_Arger__c='AErger' alone lists EXACTLY the dissatisfied
         customers (AC6). -->
</Report>
