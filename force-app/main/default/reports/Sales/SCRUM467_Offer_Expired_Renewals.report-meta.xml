<?xml version="1.0" encoding="UTF-8"?>
<!-- SCRUM-467: overview 2 = open deals whose offer is ALREADY expired
     (= the renewals that are due today). Filter = expiry gate Offer_Expired__c
     AND stage not won/lost (house-proven multi-value notEqual on STAGE_NAME).
     The grouping field (expiry date) is NOT repeated in <columns>.
     Offer_Days_Left__c is deliberately NOT a column: it is blank for an expired
     offer by design (never a negative count).
     timeFrameFilter on CREATED_DATE for the reason given in the other report. -->
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <field>OPPORTUNITY_NAME</field>
    </columns>
    <columns>
        <field>ACCOUNT_NAME</field>
    </columns>
    <columns>
        <field>FULL_NAME</field>
    </columns>
    <columns>
        <field>AMOUNT</field>
    </columns>
    <columns>
        <field>STAGE_NAME</field>
    </columns>
    <columns>
        <field>Opportunity.Offer_Sent_On__c</field>
    </columns>
    <columns>
        <field>Opportunity.Offer_Valid_Until__c</field>
    </columns>
    <columns>
        <field>Opportunity.Offer_Status__c</field>
    </columns>
    <description>SCRUM-467 AC10: open deals whose offer has already expired (gate Offer_Expired__c, stage not won/lost) - the renewals due today. Grouped by expiry date, oldest first.</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.Offer_Expired__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <column>STAGE_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>notEqual</operator>
            <value>Closed Won,Closed Lost</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity.Offer_Expires_On__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>SCRUM467_Offer_Expired_Renewals</name>
    <params>
        <name>open</name>
        <value>all</value>
    </params>
    <params>
        <name>probability</name>
        <value>&gt;0</value>
    </params>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Opportunity</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>CREATED_DATE</dateColumn>
        <endDate>2099-12-31</endDate>
        <interval>INTERVAL_CUSTOM</interval>
        <startDate>2000-01-01</startDate>
    </timeFrameFilter>
</Report>
