<?xml version="1.0" encoding="UTF-8"?>
<!-- SCRUM-453 AC-8: OVERVIEW of the customers that effectively have no contact person
     any more — every Contact of that Account is marked as having left.
     Filter = the two system-maintained Account aggregates:
       Contacts_Without_Mark__c equals 0  AND  Contacts_Left_Count__c greaterThan 0.
     The second criterion implements the PO decision "customers that never had
     a contact person are excluded" (no extra field).
     ACCOUNT.NAME is the grouping (groupingsDown), NOT a column: the deploy rejects
     a field that appears in both lists ("You can't include groupings in the
     selected columns list"). House: Miserable_Kunde_Satisfaction.
     USERS.NAME is the account owner — OWNER_FULL_NAME is NOT a valid AccountList
     column (read from the Analytics API reportTypes/AccountList).
     THIS FILE IS THE ORG'S OWN METADATA (ADR-7 house rule): it was retrieved
     after the first deploy, not written from scratch. The org added <params>co=1
     and the timeFrameFilter DUE_DATE/INTERVAL_CUSTOM on its own — carrying them
     here keeps branch and Test-Org identical, so the Prod-Org Drift Gate stays
     honest. No window was chosen by us; INTERVAL_CUSTOM is the org default. -->
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <field>USERS.NAME</field>
    </columns>
    <columns>
        <field>Account.Last_Contact_Left_Date__c</field>
    </columns>
    <columns>
        <field>Account.Contacts_Left_Count__c</field>
    </columns>
    <columns>
        <field>Account.Contacts_Without_Mark__c</field>
    </columns>
    <description>SCRUM-453 AC-8: exactly the customers whose every contact person has left (Contacts_Without_Mark__c=0 AND Contacts_Left_Count__c&gt;0). Customer, account owner, date the last contact left, both counts. Oldest leaving first.</description>
    <filter>
        <criteriaItems>
            <column>Account.Contacts_Without_Mark__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Contacts_Left_Count__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>greaterThan</operator>
            <value>0</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>ACCOUNT.NAME</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Kunde_ohne_Kontaktperson</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>AccountList</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <sortColumn>Account.Last_Contact_Left_Date__c</sortColumn>
    <sortOrder>Asc</sortOrder>
    <timeFrameFilter>
        <dateColumn>DUE_DATE</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
