<?xml version="1.0" encoding="UTF-8"?>
<!-- SCRUM-453 AC-8: OVERVIEW of the customers that effectively have no contact person
     any more — every Contact of that Account is marked as having left.
     Filter = the two system-maintained Account aggregates:
       Contacts_Without_Mark__c equals 0  AND  Contacts_Left_Count__c greaterThan 0.
     The second criterion is what implements the PO decision "customers that never had
     a contact person are excluded" (no extra field).
     Columns: customer, account owner (USERS.NAME — OWNER_FULL_NAME is NOT a valid
     AccountList column, read from the Analytics API), when the last contact left,
     and both counts. Sorted Asc on Last_Contact_Left_Date__c = oldest first.
     NO timeFrameFilter (house SCRUM-443 finding: a window silently drops rows and
     there is no matching interval token here).
     Report placement/sharing = Org step S2 (@devops-agent). -->
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <field>ACCOUNT.NAME</field>
    </columns>
    <columns>
        <field>USERS.NAME</field>
    </columns>
    <columns>
        <field>Account.Last_Contact_Left_Date__c</field>
    </columns>
    <columns>
        <field>Account.Contacts_Left_Count__c</field>
    </columns>
    <columns>
        <field>Account.Contacts_Without_Mark__c</field>
    </columns>
    <description>SCRUM-453 AC-8: exactly the customers whose every contact person has left (Contacts_Without_Mark__c=0 AND Contacts_Left_Count__c&gt;0). Customer, account owner, date the last contact left, both counts. Oldest leaving first.</description>
    <filter>
        <criteriaItems>
            <column>Account.Contacts_Without_Mark__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Contacts_Left_Count__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>greaterThan</operator>
            <value>0</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>ACCOUNT.NAME</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Kunde_ohne_Kontaktperson</name>
    <reportType>AccountList</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <sortColumn>Account.Last_Contact_Left_Date__c</sortColumn>
    <sortOrder>Asc</sortOrder>
</Report>
