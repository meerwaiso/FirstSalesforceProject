<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Top_20_Inaktivste_Kunden</fullName>
    <description>Top 20 Kunden mit den aeltesten Kontaktdaten (nach Tagen ohne Kontakt)</description>
    <format>Tabular</format>
    <name>Top 20 Inaktivste Kunden</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>AccountList</reportType>
    <scope>organization</scope>
    <sortOrder>Asc</sortOrder>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <filters>
        <field>Account.LastContactDate__c</field>
        <operation>isNotNull</operation>
    </filters>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Account.LastContactDate__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
</Report>